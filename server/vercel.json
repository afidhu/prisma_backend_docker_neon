{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
    "rewrites": [{ "source": "/(.*)", "destination": "/src/index.js" }]
},
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ]
}
