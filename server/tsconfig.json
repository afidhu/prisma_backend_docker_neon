{
  "compilerOptions": {
    // "rootDir": "src",
    "outDir": "dist",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "generated"],
  "exclude": ["node_modules"]
}
